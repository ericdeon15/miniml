# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "A small ML-style programming language implemented in OCaml"
description: """
MiniML is a small programming language built in OCaml.
   The project includes a lexer, parser, type checker, and interpreter
   implemented in OCaml using dune."""
maintainer: ["Eric D'Eon <ericdeon15@gmail.com>"]
authors: ["Eric D'Eon <ericdeon15@gmail.com>"]
license: "MIT"
tags: ["compiler" "programming-language" "interpreter" "ocaml"]
homepage: "https://github.com/ericdeon15/miniml"
doc: "https://github.com/ericdeon15/miniml"
bug-reports: "https://github.com/ericdeon15/miniml/issues"
depends: [
  "ocaml"
  "dune" {>= "3.23"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/ericdeon15/miniml.git"
x-maintenance-intent: ["(latest)"]
